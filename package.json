{
  "name": "wizard-tracker",
  "version": "1.0.1",
  "private": true,
  "description": "Punkte-Tracker (PWA) für das Kartenspiel Wizard",
  "type": "module",
  "scripts": {
    "wizard": "npx http-server -p 8000 -c-1",
    "test": "node --test tests/",
    "build:css": "tailwindcss -c tailwind.config.cjs -i css/tailwind.src.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i css/tailwind.src.css -o css/tailwind.css --watch"
  },
  "license": "ISC",
  "devDependencies": {
    "daisyui": "^3.9.4",
    "http-server": "^14.1.1",
    "tailwindcss": "^3.4.17"
  }
}
